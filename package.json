{
  "name": "@storybook-community/storybook-addon-mock-root",
  "description": "A monorepo for storybook-addon-mock",
  "version": "10.1.2",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm addon:build && pnpm docs:build",
    "build:storybook": "pnpm docs:build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test --coverage",
    "ci": "pnpm lint && pnpm test && pnpm addon:build && pnpm docs:build",
    "addon:build": "pnpm --filter @storybook-community/storybook-addon-mock build",
    "docs:start": "pnpm --filter @storybook-community/storybook-addon-mock-docs storybook",
    "docs:build": "pnpm --filter @storybook-community/storybook-addon-mock-docs build",
    "dedup": "pnpm dedupe"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/storybook-community/storybook-addon-mock.git"
  },
  "keywords": [
    "storybook",
    "storybook-community",
    "mock",
    "http-mock",
    "fetch-mock",
    "xhr-mock",
    "mock-data",
    "storybook-addon",
    "data-state",
    "storybook-mock-request",
    "storybook-mock-fetch",
    "mock-request"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/eslint-parser": "^7.21.3",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.32.2",
    "globals": "^16.5.0",
    "jest": "catalog:",
    "prettier": "^3.6.2",
    "prop-types": "catalog:",
    "typescript-eslint": "^8.47.0",
    "webpack": "^5.104.1"
  },
  "resolutions": {
    "highlight.js": "^9.18.5",
    "prismjs": "^1.30.0"
  },
  "packageManager": "pnpm@12.21.0"
}
