{
  "name": "@storybook-community/storybook-addon-mock-root",
  "description": "A monorepo for storybook-addon-mock",
  "version": "10.1.2",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm addon:build && pnpm docs:build",
    "build:storybook": "pnpm docs:build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test --coverage",
    "ci": "pnpm lint && pnpm test && pnpm addon:build && pnpm docs:build",
    "addon:build": "pnpm --filter @storybook-community/storybook-addon-mock build",
    "release": "pnpm --filter @storybook-community/storybook-addon-mock release",
    "release:canary": "pnpm --filter @storybook-community/storybook-addon-mock release:canary",
    "docs:start": "pnpm --filter @storybook-community/storybook-addon-mock-docs storybook",
    "docs:build": "pnpm --filter @storybook-community/storybook-addon-mock-docs build",
    "dedup": "pnpm dedupe"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybook-community/storybook-addon-mock.git"
  },
  "keywords": [
    "storybook",
    "storybook-community",
    "mock",
    "http-mock",
    "fetch-mock",
    "xhr-mock",
    "mock-data",
    "storybook-addon",
    "data-state",
    "storybook-mock-request",
    "storybook-mock-fetch",
    "mock-request"
  ],
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@eslint/js": "^9.39.5",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.72.2"
  },
  "packageManager": "pnpm@12.21.0"
}
